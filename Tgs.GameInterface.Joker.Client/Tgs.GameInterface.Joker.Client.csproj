<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.8</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-joker</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-joker.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GameInterface.Joker.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.Joker.Client</PackageId>
		<Title>Tgs.GameInterface.Joker.Client</Title>
		<Description>Tgs.GameInterface.Joker.Client</Description>
		<PackageTags>Tgs GameInterface Joker Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.59.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.59.0" />
		<PackageReference Include="Grpc.Tools" Version="2.60.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Tgs.GameInterface.Joker\Protos\gameinterfacejoker.proto" GrpcServices="Client">
			<Link>gameinterfacejoker.proto</Link>
		</Protobuf>
	</ItemGroup>

</Project>
